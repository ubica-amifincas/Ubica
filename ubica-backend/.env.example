# Supabase (Transaction Pooler). Copia la cadena desde Supabase > Connect.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-1-eu-north-1.pooler.supabase.com:6543/postgres?sslmode=require

# Secreto para firmar los JWT. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Correo (Resend). Vacío en local = no se envían correos.
RESEND_API_KEY=
FRONTEND_URL=http://localhost:5173

# IA
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Opcionales: modelo de cada proveedor
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
