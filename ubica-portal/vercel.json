{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
                { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'sha256-dM2Cv+6Izoq6Ne8Eqloe+m9Ir1W6sXkRj1d5fqOsb9I=' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://unpkg.com https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://ubica-backend.onrender.com https://nominatim.openstreetmap.org https://accounts.google.com/gsi/ https://unpkg.com; frame-src https://accounts.google.com/gsi/ https://www.google.com https://maps.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self'; manifest-src 'self'" }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www.amifincas.es" }],
            "destination": "https://amifincas.es/:path*",
            "permanent": true
        },
        {
            "source": "/ami-fincas",
            "has": [{ "type": "host", "value": "amifincas.es" }],
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/ami-fincas",
            "has": [{ "type": "host", "value": "ubica.amifincas.es" }],
            "destination": "https://amifincas.es/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/favicon.ico",
            "has": [{ "type": "host", "value": "amifincas.es" }],
            "destination": "/ami-fincas/favicon.ico"
        },
        {
            "source": "/favicon.ico",
            "destination": "/icons/favicon.ico"
        },
        {
            "source": "/mcp",
            "destination": "https://ubica-backend.onrender.com/mcp"
        },
        {
            "source": "/ami-fincas",
            "destination": "/ami.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
