{
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www.amifincas.es" }],
            "destination": "https://amifincas.es/:path*",
            "permanent": true
        },
        {
            "source": "/ami-fincas",
            "has": [{ "type": "host", "value": "amifincas.es" }],
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/ami-fincas",
            "has": [{ "type": "host", "value": "ubica.amifincas.es" }],
            "destination": "https://amifincas.es/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/ami-fincas",
            "destination": "/ami.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
