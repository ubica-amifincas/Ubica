{
    "id": "/",
    "name": "Ubica - Portal Inmobiliario",
    "short_name": "Ubica",
    "description": "Menos búsquedas, más precisión. Tu portal inmobiliario.",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#357186",
    "orientation": "any",
    "scope": "/",
    "share_target": {
        "action": "/publicar/compartir",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "photos",
                    "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".heic"]
                }
            ]
        }
    },
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Subir inmueble",
            "short_name": "Subir",
            "description": "Publicar un inmueble desde el móvil",
            "url": "/publicar",
            "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Ver mapa",
            "short_name": "Mapa",
            "description": "Buscar inmuebles en el mapa",
            "url": "/?view=map",
            "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        }
    ],
    "categories": [
        "business",
        "lifestyle"
    ],
    "lang": "es",
    "dir": "ltr"
}
